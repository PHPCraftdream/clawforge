{
  "name": "@clawforge/framework",
  "version": "0.1.0",
  "description": "ClawForge framework and CLI for operating self-hosted OpenClaw deployments.",
  "keywords": [
    "clawforge",
    "openclaw",
    "mcp",
    "docker",
    "self-hosting"
  ],
  "author": "ClawForge contributors",
  "license": "(MIT OR Apache-2.0)",
  "homepage": "https://github.com/PHPCraftdream/clawforge#readme",
  "bugs": {
    "url": "https://github.com/PHPCraftdream/clawforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PHPCraftdream/clawforge.git",
    "directory": "tools/framework"
  },
  "type": "module",
  "imports": {
    "#src/*": "./*"
  },
  "bin": {
    "clawforge": "dist/entry/bin.js"
  },
  "exports": {
    "./app": "./dist/core/app.js",
    "./mounts": "./dist/runtime/mounts.js",
    "./commands": "./dist/commands/interface/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepack": "node --experimental-strip-types ../build-framework-package.ts"
  },
  "dependencies": {
    "json5": "^2.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
